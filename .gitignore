# macOS & OS junk
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Environment files
backend/.env
backend/.env.*
!backend/.env.example
backend/.env.backup
backend/.env.production

# Backend dependencies & generated files
backend/vendor/
backend/node_modules/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/debugbar/
backend/.phpunit.result.cache

# Laravel storage logs and cache
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
!backend/storage/framework/cache/data/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore

# Flutter build artifacts
mobile-apps/*/.dart_tool/
mobile-apps/*/build/
mobile-apps/*/.flutter-plugins
mobile-apps/*/.flutter-plugins-dependencies
mobile-apps/*/.packages

# Skill binaries (auto-fetched on demand)
.agents/skills/impeccable/scripts/bin/
